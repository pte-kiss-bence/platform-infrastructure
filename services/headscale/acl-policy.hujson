// Háromszintű ACL — admin / dev / guest (ADR-0004, ADR-0009).
// Forrás-igazság ez a fájl; a szerverre kézzel kerül
// (/opt/headscale/config/acl-policy.hujson), változás után:
//   docker compose -f /opt/headscale/docker-compose.yml kill -s HUP headscale
//
// A usernevek a Pocket ID-s email címek — ellenőrzés a szerveren:
//   headscale users list
// A host IP-k a gépek tailnet IP-i — kitöltés a join után:
//   headscale nodes list
//
// Új projekt-VPS felvétele (services/projekt/RUNBOOK.md): host-bejegyzés
// ide + a gép a dev-szabály dst-jébe; guest-nek CSAK azt a projektet add
// hozzá, amire a külsős csapat meghívást kapott (ADR-0009: a
// guest-hozzáférés projekt-szintű).
{
  "groups": {
    // Admin: minden (Dokploy panel, SSH, minden gép)
    "group:admin": [
      "kiss.bence1@pte.hu",
    ],
    // Dev: Forgejo (web + git SSH) és a projekt-VPS-ek
    "group:dev": [
      // "csapattag@pte.hu",
    ],
    // Guest: más PTE-s csapatok, projektenkénti meghívással
    "group:guest": [
      // "vendeg@pte.hu",
    ],
  },

  "hosts": {
    "dokploy":        "__DOKPLOY_TAILNET_IP__/32",
    "forgejo":        "__FORGEJO_TAILNET_IP__/32",
    "runner":         "__RUNNER_TAILNET_IP__/32",
    "backup":         "__BACKUP_TAILNET_IP__/32",
    "beleptetoreteg": "__HEADSCALE_TAILNET_IP__/32",
    // A csapat saját belső tool-gépe (infra, nem app-projekt — ADR-0009):
    "shared":         "__SHARED_TAILNET_IP__/32",
    // Projekt-VPS-ek — app-projektenként egy bejegyzés:
    // "projekt-<nev>": "<tailnet IP>/32",
  },

  "acls": [
    // Admin mindent elér
    {"action": "accept", "src": ["group:admin"], "dst": ["*:*"]},

    // Dev: Forgejo web (Traefik 80/443) + git SSH (host 2222) + a belső
    // toolok + minden projekt-VPS (új app-projektnél bővítendő)
    {"action": "accept", "src": ["group:dev"], "dst": [
      "forgejo:80,443,2222",
      "shared:80,443",
      // "projekt-<nev>:80,443",
    ]},

    // Guest: CSAK a meghívott projekt(ek) — új meghívásnál ide vedd fel
    // az adott projekt-VPS-t (per-app szűkítés: app-oldali OIDC)
    // {"action": "accept", "src": ["group:guest"], "dst": [
    //   "projekt-<nev>:80,443",
    // ]},

    // Mindenki eléri a tailnet-resolvert (DNS) — enélkül nincs névfeloldás
    {"action": "accept", "src": ["*"], "dst": ["beleptetoreteg:53"]},

    // A beléptető réteg a napi dumpot a backup gépre tolja (ADR-0008)
    {"action": "accept", "src": ["beleptetoreteg"], "dst": ["backup:8000"]},
  ],
}
